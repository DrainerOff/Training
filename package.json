{
  "name": "training-tracker",
  "private": true,
  "version": "1.3.0",
  "description": "Offline-first strength training tracker (PWA) with Google Sheets sync via Apps Script",
  "type": "module",
  "scripts": {
    "serve": "node tests/helpers/dev-server.js",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/server/*.test.js\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "icons": "python3 tools/make_icons.py",
    "check:blockers": "node tools/blockers/check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
